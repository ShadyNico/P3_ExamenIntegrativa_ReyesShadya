@model IEnumerable<Airline>
@{ ViewData["Title"] = "Aerolíneas"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Aerolíneas</h1>@if (User.IsInRole("Administrador") || User.IsInRole("Supervisor")) { <a asp-action="Create" class="btn btn-primary">Crear</a> }</div>
@if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>ID</th><th>IATA</th><th>Nombre</th><th>Aeropuerto base</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.AirlineId</td><td>@item.Iata.Trim()</td><td>@item.AirlineName</td><td>@(item.BaseAirport?.Name ?? $"Ausente #{item.BaseAirportId}")</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.AirlineId" class="btn btn-sm btn-outline-info">Ver</a> @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor")) { <a asp-action="Edit" asp-route-id="@item.AirlineId" class="btn btn-sm btn-outline-primary">Editar</a> } @if (User.IsInRole("Administrador")) { <a asp-action="Delete" asp-route-id="@item.AirlineId" class="btn btn-sm btn-outline-danger">Eliminar</a> }</td></tr> }
</tbody></table></div><partial name="_Pagination" />
