@model Airline
@{ ViewData["Title"] = "Eliminar aerolínea"; }
<h1>Eliminar aerolínea</h1><p>¿Eliminar <strong>@(Model.AirlineName ?? Model.Iata)</strong>?</p><form asp-route-id="@Model.AirlineId" method="post"><button class="btn btn-danger">Eliminar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form>
