@model BookingFormViewModel
@{ ViewData["Title"] = "Editar reserva"; }
<h1>Editar reserva #@Model.BookingId</h1><form asp-route-id="@Model.BookingId" method="post"><partial name="_Form" model="Model" /><button class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
