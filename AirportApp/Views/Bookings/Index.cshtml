@model IEnumerable<Booking>
@{ ViewData["Title"] = "Reservas"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Reservas</h1>@if (User.IsInRole("Administrador") || User.IsInRole("Supervisor")) { <a asp-action="Create" class="btn btn-primary">Crear reserva</a> }</div>
<form method="get" class="d-flex gap-2 mb-3"><input name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Vuelo, pasaporte, apellido o asiento" /><button class="btn btn-primary">Buscar</button></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>ID</th><th>Vuelo</th><th>Pasajero</th><th>Asiento</th><th>Precio</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.BookingId</td><td>@item.Flight.FlightNo.Trim() (#@item.FlightId)</td><td>@item.Passenger.LastName, @item.Passenger.FirstName</td><td>@(item.Seat?.Trim() ?? "Sin asignar")</td><td>@item.Price.ToString("C")</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-info">Ver</a> @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor")) { <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-primary">Editar</a> } @if (User.IsInRole("Administrador")) { <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-danger">Eliminar</a> }</td></tr> }</tbody></table></div><partial name="_Pagination" />
