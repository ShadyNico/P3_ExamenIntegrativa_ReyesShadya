@model IEnumerable<Flight>
@{
    ViewData["Title"] = "Vuelos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-1">Catálogo de vuelos</h1>
        <p class="text-muted mb-0">Consulta rutas, horarios, aerolíneas y aviones.</p>
    </div>
    @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor"))
    {
        <a asp-action="Create" class="btn btn-primary">Crear vuelo</a>
    }
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label for="buscar" class="form-label">Vuelo, aeropuerto o aerolínea</label>
            <input id="buscar" name="buscar" value="@ViewData["Buscar"]" class="form-control" />
        </div>
        <div class="col-md-3">
            <label for="duracionMinima" class="form-label">Duración mínima (min)</label>
            <input id="duracionMinima" name="duracionMinima" type="number" min="1"
                   value="@ViewData["DuracionMinima"]" class="form-control" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary flex-fill">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
        <tr>
            <th>Vuelo</th>
            <th>Ruta</th>
            <th>Salida</th>
            <th>Llegada</th>
            <th>Duración</th>
            <th>Aerolínea</th>
            <th class="text-end">Acciones</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.FlightNo.Trim()</strong><br /><small>#@item.FlightId</small></td>
                <td>@item.FromAirport.Icao.Trim() → @item.ToAirport.Icao.Trim()</td>
                <td>@item.Departure.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.Arrival.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@Math.Round(item.Duration.TotalMinutes) min</td>
                <td>@(item.Airline.AirlineName ?? item.Airline.Iata)</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.FlightId" class="btn btn-sm btn-outline-info">Ver</a>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.FlightId" class="btn btn-sm btn-outline-primary">Editar</a>
                    }
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.FlightId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (ViewData["Pagination"] is not null)
{
    <partial name="_Pagination" />
}
