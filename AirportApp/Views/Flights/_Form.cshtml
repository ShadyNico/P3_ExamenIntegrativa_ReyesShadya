@model FlightFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input asp-for="FlightId" type="hidden" />
<div class="mb-3">
    <label asp-for="FlightNo" class="form-label"></label>
    <select asp-for="FlightNo" asp-items="@(ViewData["FlightNo"] as SelectList)" class="form-select">
        <option value="">Seleccione un vuelo programado</option>
    </select>
    <span asp-validation-for="FlightNo" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Departure" class="form-label"></label>
        <input asp-for="Departure" class="form-control" />
        <span asp-validation-for="Departure" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Arrival" class="form-label"></label>
        <input asp-for="Arrival" class="form-control" />
        <span asp-validation-for="Arrival" class="text-danger"></span>
    </div>
</div>
<div class="mb-3">
    <label asp-for="AirplaneId" class="form-label"></label>
    <select asp-for="AirplaneId" asp-items="@(ViewData["AirplaneId"] as SelectList)" class="form-select">
        <option value="">Seleccione un avión</option>
    </select>
    <span asp-validation-for="AirplaneId" class="text-danger"></span>
</div>
