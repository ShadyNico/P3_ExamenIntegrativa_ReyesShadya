@model Passenger
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input asp-for="PassengerId" type="hidden" />
<div class="mb-3"><label asp-for="PassportNo" class="form-label">Pasaporte</label><input asp-for="PassportNo" class="form-control" maxlength="9" /><span asp-validation-for="PassportNo" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="FirstName" class="form-label">Nombres</label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="LastName" class="form-label">Apellidos</label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
