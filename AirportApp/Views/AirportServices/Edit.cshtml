@model AirportServiceFormViewModel
@{ ViewData["Title"] = "Editar servicio"; }
<div class="row justify-content-center"><div class="col-lg-9">
    <div class="page-header"><h1>Editar servicio aeroportuario</h1></div>
    <form method="post" class="card border-0 shadow-sm"><div class="card-body p-4">
        <input asp-for="AirportServiceId" type="hidden" />
        <partial name="_Form" model="Model" />
        <div class="d-flex flex-wrap gap-2 mt-4"><button class="btn btn-primary">Guardar cambios</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.AirportServiceId">Cancelar</a></div>
    </div></form>
    @if (Model.IsActive)
    {
        <form asp-action="Deactivate" asp-route-id="@Model.AirportServiceId" method="post" class="mt-3" onsubmit="return confirm('¿Desactivar este servicio? No se borrará su historial.');">
            <button class="btn btn-outline-danger">Desactivar servicio</button>
        </form>
    }
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
