@model ServiceSelectionViewModel
@{
    ViewData["Title"] = Model.Name;
}
<partial name="_ServiceBookingSteps" model="2" />
<div class="row justify-content-center">
    <div class="col-lg-9">
        <a class="text-decoration-none" asp-action="Index" asp-route-airportId="@Model.AirportId">← Servicios</a>
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body p-4 p-lg-5">
                <span class="badge text-bg-primary">@AirportServiceLabels.ServiceType(Model.ServiceType)</span>
                <h1 class="mt-3">@Model.Name</h1>
                <p class="lead text-muted">@Model.Description</p>
                <dl class="row">
                    <dt class="col-sm-4">Aeropuerto</dt><dd class="col-sm-8">@Model.AirportName</dd>
                    <dt class="col-sm-4">Precio base</dt><dd class="col-sm-8">@Model.BasePrice.ToString("C2")</dd>
                    <dt class="col-sm-4">Modalidad</dt><dd class="col-sm-8">@AirportServiceLabels.PriceType(Model.PriceType)</dd>
                    <dt class="col-sm-4">Disponibilidad</dt><dd class="col-sm-8">@Model.AvailableSlotCount horarios abiertos</dd>
                </dl>
                <a class="btn btn-primary btn-lg" asp-controller="Availability" asp-action="Index"
                   asp-route-airportId="@Model.AirportId" asp-route-airportServiceId="@Model.AirportServiceId">Consultar horarios</a>
                @if (User.IsInRole("Administrador"))
                {
                    <a class="btn btn-outline-secondary btn-lg ms-2" asp-action="Edit" asp-route-id="@Model.AirportServiceId">Administrar</a>
                }
            </div>
        </div>
    </div>
</div>
