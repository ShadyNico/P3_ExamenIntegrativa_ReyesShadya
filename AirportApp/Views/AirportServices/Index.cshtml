@model IReadOnlyList<ServiceSelectionViewModel>
@{
    ViewData["Title"] = "Servicios aeroportuarios";
    var airports = ViewBag.Airports as IReadOnlyList<SelectListItem> ?? [];
}
<div class="page-header">
    <div>
        <h1>Servicios aeroportuarios</h1>
        <p class="text-muted mb-0">Catálogo activo y disponibilidad para los próximos 30 días.</p>
    </div>
    @if (User.IsInRole("Administrador"))
    {
        <a class="btn btn-primary" asp-action="Create">Crear servicio</a>
    }
</div>
<form method="get" class="card border-0 bg-light mb-4">
    <div class="card-body row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="airportId">Filtrar por aeropuerto</label>
            <select class="form-select" id="airportId" name="airportId" asp-items="airports">
                <option value="">Todos los aeropuertos</option>
            </select>
        </div>
        <div class="col-md-4"><button class="btn btn-outline-primary w-100">Aplicar filtro</button></div>
    </div>
</form>
<div class="row g-3">
    @foreach (var service in Model)
    {
        <div class="col-md-6 col-xl-4">
            <article class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4 d-flex flex-column">
                    <small class="text-primary fw-semibold">@service.AirportName</small>
                    <h2 class="h5 mt-2">@service.Name</h2>
                    <p class="text-muted flex-grow-1">@service.Description</p>
                    <div class="d-flex justify-content-between mb-3">
                        <span><strong>@service.BasePrice.ToString("C2")</strong></span>
                        <span class="badge text-bg-light">@service.AvailableSlotCount horarios</span>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-primary flex-grow-1" asp-action="Details" asp-route-id="@service.AirportServiceId">Detalles</a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@service.AirportServiceId">Editar</a>
                        }
                    </div>
                </div>
            </article>
        </div>
    }
</div>
