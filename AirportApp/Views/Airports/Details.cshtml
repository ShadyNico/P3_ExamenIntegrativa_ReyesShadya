@model AirportDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}
<partial name="_ServiceBookingSteps" model="2" />
<div class="page-header">
    <div>
        <a class="text-decoration-none" asp-action="Index">← Aeropuertos</a>
        <h1 class="mt-2">@Model.Name</h1>
        <p class="text-muted mb-0">@Model.Iata · @Model.Icao</p>
    </div>
</div>
<div class="row g-4">
    @foreach (var service in Model.Services)
    {
        <div class="col-md-6 col-xl-4">
            <article class="card h-100 border-0 shadow-sm service-card">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between gap-2">
                        <span class="badge text-bg-primary">@AirportServiceLabels.ServiceType(service.ServiceType)</span>
                        <span class="badge text-bg-light">@service.AvailableSlotCount horarios</span>
                    </div>
                    <h2 class="h5 mt-3">@service.Name</h2>
                    <p class="text-muted flex-grow-1">@service.Description</p>
                    <div class="mb-3"><strong>@service.BasePrice.ToString("C2")</strong> <small class="text-muted">@AirportServiceLabels.PriceType(service.PriceType).ToLowerInvariant()</small></div>
                    <a class="btn btn-primary" asp-controller="Availability" asp-action="Index"
                       asp-route-airportId="@service.AirportId" asp-route-airportServiceId="@service.AirportServiceId">Elegir fecha y horario</a>
                </div>
            </article>
        </div>
    }
</div>
