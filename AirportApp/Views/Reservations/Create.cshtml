@model ReservationCreateViewModel
@{
    ViewData["Title"] = "Datos de la reserva";
}
<partial name="_ServiceBookingSteps" model="4" />
<div class="row g-4">
    <div class="col-lg-8">
        <div class="page-header"><div><h1>Datos del cliente</h1><p class="text-muted mb-0">@Model.AirportName · @Model.ServiceName</p></div></div>
        <form method="post" class="card border-0 shadow-sm" id="reservation-form">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input asp-for="AirportServiceId" type="hidden" />
                <div class="mb-3">
                    <label asp-for="ServiceAvailabilityId" class="form-label"></label>
                    <select asp-for="ServiceAvailabilityId" asp-items="Model.AvailableSlots" class="form-select"><option value="">Selecciona un horario...</option></select>
                    <span asp-validation-for="ServiceAvailabilityId" class="text-danger"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="CustomerName" class="form-label"></label><input asp-for="CustomerName" class="form-control" /><span asp-validation-for="CustomerName" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="CustomerEmail" class="form-label"></label><input asp-for="CustomerEmail" class="form-control" /><span asp-validation-for="CustomerEmail" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="CustomerPhone" class="form-label"></label><input asp-for="CustomerPhone" class="form-control" /><span asp-validation-for="CustomerPhone" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" class="form-control" min="1" max="100" /><span asp-validation-for="Quantity" class="text-danger"></span></div>
                </div>
                <button class="btn btn-primary btn-lg mt-4">Crear reserva y revisar</button>
            </div>
        </form>
    </div>
    <div class="col-lg-4">
        <aside class="card border-0 bg-light sticky-lg-top" style="top:1rem">
            <div class="card-body p-4">
                <h2 class="h5">Precio estimado</h2>
                <p class="small text-muted">@Model.UnitPrice.ToString("C2") · @Model.PriceTypeLabel</p>
                <div class="d-flex justify-content-between"><span>Subtotal</span><strong id="price-subtotal">—</strong></div>
                <div class="d-flex justify-content-between"><span>IVA 15 %</span><strong id="price-tax">—</strong></div>
                <hr /><div class="d-flex justify-content-between fs-5"><span>Total</span><strong id="price-total">—</strong></div>
                <p class="small text-muted mt-3 mb-0">El servidor recalculará el precio; este resumen no se usa como valor confiable.</p>
            </div>
        </aside>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const quantity = document.getElementById('Quantity');
        const currency = new Intl.NumberFormat('es-EC', { style: 'currency', currency: 'USD' });
        async function calculatePrice() {
            const body = new URLSearchParams({ airportServiceId: '@Model.AirportServiceId', quantity: quantity.value });
            body.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
            const response = await fetch('@Url.Action("CalculatePrice")', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
            if (!response.ok) return;
            const price = await response.json();
            document.getElementById('price-subtotal').textContent = currency.format(price.subtotal);
            document.getElementById('price-tax').textContent = currency.format(price.tax);
            document.getElementById('price-total').textContent = currency.format(price.total);
        }
        quantity?.addEventListener('input', calculatePrice);
        calculatePrice();
    </script>
}
