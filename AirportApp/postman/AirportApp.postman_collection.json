{
  "info": {
    "_postman_id": "dc284926-91b8-4f43-8f21-airportapp",
    "name": "AirportApp API",
    "description": "Comprobaciones del healthcheck y del asistente local Ollama. Las rutas MVC protegidas usan la cookie de Identity obtenida al iniciar sesión en el navegador.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Healthcheck",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Estructura saludable', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('Healthy');",
              "  pm.expect(body.application).to.eql('AirportApp');",
              "  pm.expect(body.domainDatabase).to.be.true;",
              "  pm.expect(body.applicationDatabase).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "IA - recomendación válida",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"consulta\": \"Sugiere una ruta corta entre aeropuertos europeos\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/ia/generar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "ia", "generar"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta y modelo presentes', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.respuesta).to.be.a('string').and.not.empty;",
              "  pm.expect(body.modelo).to.be.a('string').and.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "IA - consulta vacía",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"consulta\": \"\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/api/ia/generar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "ia", "generar"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Mensaje legible', () => pm.expect(pm.response.json().mensaje).to.be.a('string').and.not.empty);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5164", "type": "string" }
  ]
}
