# Copia este archivo como .env. Nunca confirmes .env ni reemplaces los marcadores aquí.
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=5433
AIRPORTAPP_PORT=5164

EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER_NAME=replace_with_sender_name
EMAIL_SENDER_EMAIL=replace_with_sender_email
EMAIL_PASSWORD=replace_with_email_app_password

GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:5164/Payment/Success
PAYPAL_CANCEL_URL=http://localhost:5164/Payment/Cancel
PAYPAL_CURRENCY_CODE=USD

PAYPHONE_TOKEN=replace_with_test_token
PAYPHONE_STORE_ID=replace_with_test_store_id

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b

# Solo Swarm: PFX con clave privada y volumen compartido airportapp_shared_keys.
DATA_PROTECTION_CERTIFICATE_PATH=C:\replace\with\airportapp-dataprotection.pfx
DATA_PROTECTION_CERTIFICATE_PASSWORD=replace_with_certificate_password
